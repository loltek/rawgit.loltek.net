# rawgit.loltek.net -- nginx config for https://github.com/loltek/rawgit.loltek.net
#
# Cloudflare proxies this name with strict TLS, so the origin needs a valid
# certificate of its own (/etc/letsencrypt/live/rawgit.loltek.net/).
# Layout: docroot /srv/http/rawgit.loltek.net/www, script.php served by PHP 8.5 FPM.
# Kept self-contained (no include) because script.php prints this file publicly.

server {
	listen 80;
	listen [::]:80;
	server_name rawgit.loltek.net;

	root /srv/http/rawgit.loltek.net/www;
	index script.php;

	# ACME HTTP-01 (certbot --webroot)
	location ^~ /.well-known/acme-challenge/ {
		default_type text/plain;
		try_files $uri =404;
	}

	location / {
		try_files $uri $uri/ /script.php$is_args$args;
	}

	# https://www.mediasuite.co.nz/blog/proxying-s3-downloads-nginx/
	location ~ ^/githubusercontent_proxy/(.+) {
		internal;
		resolver 8.8.8.8 ipv6=off;
		set $proxy_url $1;
		proxy_http_version 1.1;
		proxy_set_header Host 'raw.githubusercontent.com';
		proxy_set_header Accept-Encoding '';
		proxy_set_header Authorization '';
		proxy_set_header Cookie '';
		proxy_hide_header 'Content-Type';
		proxy_hide_header 'Connection';
		proxy_hide_header 'content-security-policy';
		proxy_pass $proxy_url$is_args$args;
	}

	location ~ \.php$ {
		index script.php;

		fastcgi_split_path_info ^(.+?\.php)(/.*)$;
		set $path_info $fastcgi_path_info;
		fastcgi_param PATH_INFO $path_info;

		fastcgi_index script.php;
		fastcgi_param  SCRIPT_FILENAME    $document_root/script.php;
		fastcgi_param  QUERY_STRING       $query_string;
		fastcgi_param  REQUEST_METHOD     $request_method;
		fastcgi_param  CONTENT_TYPE       $content_type;
		fastcgi_param  CONTENT_LENGTH     $content_length;
		fastcgi_param  SCRIPT_NAME        /script.php;
		fastcgi_param  REQUEST_URI        $request_uri;
		fastcgi_param  DOCUMENT_URI       $document_uri;
		fastcgi_param  DOCUMENT_ROOT      $document_root;
		fastcgi_param  SERVER_PROTOCOL    $server_protocol;
		fastcgi_param  REQUEST_SCHEME     $scheme;
		fastcgi_param  HTTPS              $https if_not_empty;

		fastcgi_param  GATEWAY_INTERFACE  CGI/1.1;
		fastcgi_param  SERVER_SOFTWARE    nginx/$nginx_version;

		fastcgi_param  REMOTE_ADDR        $remote_addr;
		fastcgi_param  REMOTE_PORT        $remote_port;
		fastcgi_param  SERVER_ADDR        $server_addr;
		fastcgi_param  SERVER_PORT        $server_port;
		fastcgi_param  SERVER_NAME        $server_name;
		fastcgi_param  REDIRECT_STATUS    200;

		fastcgi_pass unix:/run/php/php8.5-fpm.sock;
	}
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name rawgit.loltek.net;

	ssl_certificate     /etc/letsencrypt/live/rawgit.loltek.net/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/rawgit.loltek.net/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;

	root /srv/http/rawgit.loltek.net/www;
	index script.php;

	location ^~ /.well-known/acme-challenge/ {
		default_type text/plain;
		try_files $uri =404;
	}

	location / {
		try_files $uri $uri/ /script.php$is_args$args;
	}

	# https://www.mediasuite.co.nz/blog/proxying-s3-downloads-nginx/
	location ~ ^/githubusercontent_proxy/(.+) {
		internal;
		resolver 8.8.8.8 ipv6=off;
		set $proxy_url $1;
		proxy_http_version 1.1;
		proxy_set_header Host 'raw.githubusercontent.com';
		proxy_set_header Accept-Encoding '';
		proxy_set_header Authorization '';
		proxy_set_header Cookie '';
		proxy_hide_header 'Content-Type';
		proxy_hide_header 'Connection';
		proxy_hide_header 'content-security-policy';
		proxy_pass $proxy_url$is_args$args;
	}

	location ~ \.php$ {
		index script.php;

		fastcgi_split_path_info ^(.+?\.php)(/.*)$;
		set $path_info $fastcgi_path_info;
		fastcgi_param PATH_INFO $path_info;

		fastcgi_index script.php;
		fastcgi_param  SCRIPT_FILENAME    $document_root/script.php;
		fastcgi_param  QUERY_STRING       $query_string;
		fastcgi_param  REQUEST_METHOD     $request_method;
		fastcgi_param  CONTENT_TYPE       $content_type;
		fastcgi_param  CONTENT_LENGTH     $content_length;
		fastcgi_param  SCRIPT_NAME        /script.php;
		fastcgi_param  REQUEST_URI        $request_uri;
		fastcgi_param  DOCUMENT_URI       $document_uri;
		fastcgi_param  DOCUMENT_ROOT      $document_root;
		fastcgi_param  SERVER_PROTOCOL    $server_protocol;
		fastcgi_param  REQUEST_SCHEME     $scheme;
		fastcgi_param  HTTPS              $https if_not_empty;

		fastcgi_param  GATEWAY_INTERFACE  CGI/1.1;
		fastcgi_param  SERVER_SOFTWARE    nginx/$nginx_version;

		fastcgi_param  REMOTE_ADDR        $remote_addr;
		fastcgi_param  REMOTE_PORT        $remote_port;
		fastcgi_param  SERVER_ADDR        $server_addr;
		fastcgi_param  SERVER_PORT        $server_port;
		fastcgi_param  SERVER_NAME        $server_name;
		fastcgi_param  REDIRECT_STATUS    200;

		fastcgi_pass unix:/run/php/php8.5-fpm.sock;
	}
}
